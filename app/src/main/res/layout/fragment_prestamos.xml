<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Préstamo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuario *"
            android:minHeight="48dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etObjeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Objeto (Libro/Herramienta) *"
            android:minHeight="48dp"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etFechaPrestamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha de Préstamo"
            android:minHeight="48dp"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvFechaAutomatica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha automática (hoy)"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etFechaDevolucion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha límite de Devolución *"
            android:minHeight="48dp"
            android:padding="12dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnRegistrarPrestamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Préstamo"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnCancelarPrestamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>